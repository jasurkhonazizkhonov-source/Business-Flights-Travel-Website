// This schema was introspected (`prisma db pull`) from the company's existing
// CRM database (the "Compass Tools" app) so this website writes leads into
// the SAME tables, statuses, and queue/assignment system the CRM already
// uses — no parallel lead system. See src/server/actions/submit-flight-request.ts.
//
// Re-pulled 2026-08-22: the CRM side has since grown its own ContactInquiry
// (+ InquiryNote), Subscriber, and MarketingCampaign(+Send) models. This
// website now writes contact-form submissions into ContactInquiry and
// newsletter signups into Subscriber instead of a bespoke table, since the
// CRM already has purpose-built homes for both — see
// src/server/actions/submit-contact-message.ts and
// src/server/actions/subscribe-newsletter.ts. Always re-pull before
// `db push` rather than forcing --accept-data-loss, which would silently
// drop whatever the CRM side has added since the last pull.
//
// `@default(cuid())` on ContactInquiry.id and Subscriber.id below was added
// back by hand after introspection, same as the rest of this file's ids —
// it's a Prisma-client-side default `db pull` can't see, copied from the
// CRM's own schema.prisma so IDs this website generates match its format.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                                 String                 @id
  fullName                           String
  email                              String                 @unique
  phone                              String?
  role                               AccountRole            @default(TRAVEL_AGENT)
  status                             AccountStatus          @default(ACTIVE)
  avatarUrl                          String?
  lastSeenAt                         DateTime?
  createdAt                          DateTime               @default(now())
  updatedAt                          DateTime
  hiredAt                            DateTime?
  paymentPermissions                 String[]               @default([])
  bookingPermissions                 String[]               @default([])
  activeSessionId                    String?                @unique
  sessionCreatedAt                   DateTime?
  companyId                          String
  location                           String?
  commissionPercent                  Decimal?               @db.Decimal(5, 2)
  Company                            Company                @relation(fields: [companyId], references: [id])
  Activity                           Activity[]
  Attachment                         Attachment[]
  AuditLog                           AuditLog[]
  BookingStatusHistory               BookingStatusHistory[]
  Contact                            Contact[]
  ContactInquiry                     ContactInquiry[]
  GmailConnection                    GmailConnection?
  InquiryNote                        InquiryNote[]
  Lead                               Lead[]
  Lead_Lead_offeredToIdToAccount     Lead[]                 @relation("Lead_offeredToIdToAccount")
  LeadQueueEntry                     LeadQueueEntry?
  LeadStatusHistory                  LeadStatusHistory[]
  MarketingCampaign                  MarketingCampaign[]
  Note                               Note[]
  Notification                       Notification[]
  PaymentCharge                      PaymentCharge[]
  Quote                              Quote[]
  Quote_Quote_sentByAgentIdToAccount Quote[]                @relation("Quote_sentByAgentIdToAccount")
  QuoteStatusHistory                 QuoteStatusHistory[]
  Sequence                           Sequence[]
  SequenceEnrollment                 SequenceEnrollment[]
  Task_Task_assigneeIdToAccount      Task[]                 @relation("Task_assigneeIdToAccount")
  Task_Task_completedByIdToAccount   Task[]                 @relation("Task_completedByIdToAccount")

  @@index([companyId])
  @@index([role])
  @@index([status])
}

model Activity {
  id          String   @id @default(cuid())
  contactId   String?
  leadId      String?
  quoteId     String?
  bookingId   String?
  actorId     String?
  type        String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  Account     Account? @relation(fields: [actorId], references: [id])
  Booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  Contact     Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Quote       Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([contactId])
  @@index([createdAt])
  @@index([leadId])
  @@index([quoteId])
}

model AircraftType {
  id            Int             @id @default(autoincrement())
  code          String?         @unique
  manufacturer  String
  model         String
  displayName   String
  FlightSegment FlightSegment[]

  @@index([displayName])
  @@index([manufacturer])
}

model Airline {
  id            Int             @id @default(autoincrement())
  iata          String?         @unique
  icao          String?
  name          String
  country       String?
  logoUrl       String?
  isActive      Boolean         @default(true)
  FlightSegment FlightSegment[]

  @@index([icao])
  @@index([name])
}

model Airport {
  id                                                      Int             @id @default(autoincrement())
  iata                                                    String          @unique
  icao                                                    String?
  name                                                    String
  city                                                    String
  country                                                 String
  countryCode                                             String?
  timezone                                                String?
  latitude                                                Float?
  longitude                                               Float?
  FlightSegment_FlightSegment_arrivalAirportIdToAirport   FlightSegment[] @relation("FlightSegment_arrivalAirportIdToAirport")
  FlightSegment_FlightSegment_departureAirportIdToAirport FlightSegment[] @relation("FlightSegment_departureAirportIdToAirport")
  Lead_Lead_arrivalAirportIdToAirport                     Lead[]          @relation("Lead_arrivalAirportIdToAirport")
  Lead_Lead_departureAirportIdToAirport                   Lead[]          @relation("Lead_departureAirportIdToAirport")

  @@index([city])
  @@index([country])
  @@index([name])
}

model Attachment {
  id           String   @id
  contactId    String?
  leadId       String?
  fileName     String
  fileUrl      String
  fileType     String?
  fileSize     Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  Contact      Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Account      Account? @relation(fields: [uploadedById], references: [id])

  @@index([contactId])
  @@index([leadId])
}

model AuditLog {
  id         String   @id
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  Account    Account? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model Booking {
  id                        String                 @id
  quoteId                   String                 @unique
  leadId                    String
  contactId                 String
  bookingReference          String                 @unique
  contactPhone              String
  contactEmail              String
  billingAddress            String
  billingApt                String?
  billingCity               String
  billingState              String
  billingZip                String
  billingCountry            String
  gratuityAmount            Decimal                @default(0) @db.Decimal(10, 2)
  totalAmount               Decimal                @default(0) @db.Decimal(10, 2)
  termsAcceptedAt           DateTime?
  status                    BookingStatus          @default(PENDING_TICKETING)
  pnr                       String?
  airlineConfirmationNumber String?
  ticketNumbers             Json?
  fareAmount                Decimal?               @db.Decimal(10, 2)
  taxAmount                 Decimal?               @db.Decimal(10, 2)
  serviceFeeAmount          Decimal?               @db.Decimal(10, 2)
  profitAmount              Decimal?               @db.Decimal(10, 2)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime
  Activity                  Activity[]
  Contact                   Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Lead                      Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Quote                     Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  BookingStatusHistory      BookingStatusHistory[]
  EmailLog                  EmailLog[]
  Passenger                 Passenger[]
  PaymentMethod             PaymentMethod[]
  Signature                 Signature?

  @@index([contactId])
  @@index([leadId])
  @@index([status])
}

model BookingStatusHistory {
  id          String         @id
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  changedById String?
  note        String?
  changedAt   DateTime       @default(now())
  Booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  Account     Account?       @relation(fields: [changedById], references: [id])

  @@index([bookingId])
}

model Company {
  id                   String               @id
  name                 String
  website              String?
  phone                String?
  brandColor           String?
  logoOriginalUrl      String?
  logoEmailUrl         String?
  logoWebUrl           String?
  logoIconUrl          String?
  logoProcessingStatus LogoProcessingStatus @default(NONE)
  logoProcessingError  String?
  signatureTemplate    String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  logoEmailData        Bytes?
  Account              Account[]
  Contact              Contact[]
  ContactInquiry       ContactInquiry[]
  MarketingCampaign    MarketingCampaign[]
  Subscriber           Subscriber[]
}

model Contact {
  id                                     String           @id @default(cuid())
  firstName                              String
  middleName                             String?
  lastName                               String
  primaryPhone                           String?
  primaryEmail                           String?
  createdAt                              DateTime         @default(now())
  updatedAt                              DateTime         @updatedAt
  ownerId                                String?
  companyId                              String
  Activity                               Activity[]
  Attachment                             Attachment[]
  Booking                                Booking[]
  Company                                Company          @relation(fields: [companyId], references: [id])
  Account                                Account?         @relation(fields: [ownerId], references: [id])
  ContactEmail                           ContactEmail[]
  ContactInquiry                         ContactInquiry[]
  ContactPhone                           ContactPhone[]
  EmailLog                               EmailLog[]
  Lead_Lead_contactIdToContact           Lead[]           @relation("Lead_contactIdToContact")
  Lead_Lead_referredByContactIdToContact Lead[]           @relation("Lead_referredByContactIdToContact")
  Note                                   Note[]
  PaymentMethod                          PaymentMethod[]
  Quote                                  Quote[]
  Task                                   Task[]

  @@index([companyId])
  @@index([lastName, firstName])
  @@index([ownerId])
  @@index([primaryEmail])
  @@index([primaryPhone])
  @@index([updatedAt])
}

model ContactEmail {
  id        String           @id @default(cuid())
  contactId String
  email     String
  type      ContactEmailType @default(PERSONAL)
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())
  Contact   Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([email])
}

model ContactPhone {
  id        String    @id @default(cuid())
  contactId String
  number    String
  type      PhoneType @default(MOBILE)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
  Contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([number])
}

model EmailLog {
  id           String      @id
  type         EmailType
  subject      String
  fromEmail    String
  toEmail      String
  status       EmailStatus
  errorMessage String?
  leadId       String?
  quoteId      String?
  bookingId    String?
  contactId    String?
  createdAt    DateTime    @default(now())
  messageId    String?
  Booking      Booking?    @relation(fields: [bookingId], references: [id])
  Contact      Contact?    @relation(fields: [contactId], references: [id])
  Lead         Lead?       @relation(fields: [leadId], references: [id])
  Quote        Quote?      @relation(fields: [quoteId], references: [id])

  @@index([bookingId])
  @@index([contactId])
  @@index([leadId])
  @@index([quoteId])
}

model FlightSegment {
  id                                                String                 @id
  itineraryId                                       String
  sequence                                          Int
  airlineId                                         Int?
  airlineCodeRaw                                    String?
  flightNumber                                      String
  bookingClass                                      String?
  cabin                                             CabinClass             @default(ECONOMY)
  departureAirportId                                Int
  arrivalAirportId                                  Int
  departureAt                                       DateTime
  arrivalAt                                         DateTime
  aircraftTypeId                                    Int?
  aircraftRaw                                       String?
  durationMinutes                                   Int?
  createdAt                                         DateTime               @default(now())
  connectionType                                    SegmentConnectionType?
  isExtraLeg                                        Boolean                @default(false)
  operatingCarrierName                              String?
  AircraftType                                      AircraftType?          @relation(fields: [aircraftTypeId], references: [id])
  Airline                                           Airline?               @relation(fields: [airlineId], references: [id])
  Airport_FlightSegment_arrivalAirportIdToAirport   Airport                @relation("FlightSegment_arrivalAirportIdToAirport", fields: [arrivalAirportId], references: [id])
  Airport_FlightSegment_departureAirportIdToAirport Airport                @relation("FlightSegment_departureAirportIdToAirport", fields: [departureAirportId], references: [id])
  Itinerary                                         Itinerary              @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([arrivalAirportId])
  @@index([departureAirportId])
  @@index([itineraryId])
}

model GmailConnection {
  id                    String                @id
  accountId             String                @unique
  googleEmail           String
  scopes                String[]
  encryptedRefreshToken String
  status                GmailConnectionStatus @default(CONNECTED)
  connectedAt           DateTime              @default(now())
  revokedAt             DateTime?
  updatedAt             DateTime
  Account               Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Itinerary {
  id            String          @id
  quoteId       String          @unique
  tripType      TripType        @default(ROUND_TRIP)
  createdAt     DateTime        @default(now())
  FlightSegment FlightSegment[]
  Quote         Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Lead {
  id                                        String               @id @default(cuid())
  contactId                                 String
  departureAirportId                        Int?
  arrivalAirportId                          Int?
  departureDate                             DateTime?
  returnDate                                DateTime?
  tripType                                  TripType             @default(ROUND_TRIP)
  cabinClass                                CabinClass           @default(ECONOMY)
  adults                                    Int                  @default(1)
  children                                  Int                  @default(0)
  infants                                   Int                  @default(0)
  flexibleDates                             Boolean              @default(false)
  preferredAirline                          String?
  budget                                    Decimal?             @db.Decimal(10, 2)
  notes                                     String?
  status                                    LeadStatus           @default(ATTEMPTING_TO_CONTACT)
  source                                    LeadSource           @default(WEBSITE)
  priority                                  Priority             @default(MEDIUM)
  assignedAgentId                           String?
  createdAt                                 DateTime             @default(now())
  updatedAt                                 DateTime             @updatedAt
  queueDistributedAt                        DateTime?
  referredByContactId                       String?
  offeredToId                               String?
  offeredAt                                 DateTime?
  offerExpiresAt                            DateTime?
  Activity                                  Activity[]
  Attachment                                Attachment[]
  Booking                                   Booking[]
  EmailLog                                  EmailLog[]
  Airport_Lead_arrivalAirportIdToAirport    Airport?             @relation("Lead_arrivalAirportIdToAirport", fields: [arrivalAirportId], references: [id])
  Account                                   Account?             @relation(fields: [assignedAgentId], references: [id])
  Contact_Lead_contactIdToContact           Contact              @relation("Lead_contactIdToContact", fields: [contactId], references: [id], onDelete: Cascade)
  Airport_Lead_departureAirportIdToAirport  Airport?             @relation("Lead_departureAirportIdToAirport", fields: [departureAirportId], references: [id])
  Account_Lead_offeredToIdToAccount         Account?             @relation("Lead_offeredToIdToAccount", fields: [offeredToId], references: [id])
  Contact_Lead_referredByContactIdToContact Contact?             @relation("Lead_referredByContactIdToContact", fields: [referredByContactId], references: [id])
  LeadStatusHistory                         LeadStatusHistory[]
  Note                                      Note[]
  Notification                              Notification[]
  Quote                                     Quote[]
  SequenceEnrollment                        SequenceEnrollment[]
  Task                                      Task[]

  @@index([assignedAgentId])
  @@index([cabinClass])
  @@index([contactId])
  @@index([createdAt])
  @@index([referredByContactId])
  @@index([source, assignedAgentId, queueDistributedAt])
  @@index([source])
  @@index([status])
  @@index([tripType])
  @@index([updatedAt])
  @@index([offeredToId])
}

model LeadQueueEntry {
  id                 String    @id
  accountId          String    @unique
  isActive           Boolean   @default(true)
  joinedAt           DateTime  @default(now())
  lastAssignedAt     DateTime?
  leadsAssignedCount Int       @default(0)
  updatedAt          DateTime
  Account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([isActive, lastAssignedAt])
}

model LeadStatusHistory {
  id          String      @id @default(cuid())
  leadId      String
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  changedById String?
  note        String?
  changedAt   DateTime    @default(now())
  Account     Account?    @relation(fields: [changedById], references: [id])
  Lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Note {
  id        String   @id
  contactId String?
  leadId    String?
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Account   Account? @relation(fields: [authorId], references: [id])
  Contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([leadId])
}

model Notification {
  id        String    @id @default(cuid())
  accountId String
  taskId    String?
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  leadId    String?
  quoteId   String?
  Account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  Lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Quote     Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  Task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, readAt])
  @@index([leadId])
  @@index([quoteId])
  @@index([taskId])
}

model Passenger {
  id                     String        @id
  bookingId              String
  type                   PassengerType @default(ADULT)
  firstName              String
  middleName             String?
  lastName               String
  dateOfBirth            DateTime?
  gender                 String?
  tsaKnownTravelerNumber String?
  globalEntryNumber      String?
  frequentFlyerAirline   String?
  frequentFlyerNumber    String?
  createdAt              DateTime      @default(now())
  Booking                Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PaymentCharge {
  id              String              @id
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("usd")
  status          PaymentChargeStatus @default(PENDING)
  errorMessage    String?
  initiatedById   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime
  paymentMethodId String
  referenceNote   String?
  Account         Account?            @relation(fields: [initiatedById], references: [id])
  PaymentMethod   PaymentMethod       @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@index([paymentMethodId])
  @@index([status])
}

model PaymentMethod {
  id              String                @id
  bookingId       String?
  cardholderName  String
  encryptedPan    String
  last4           String
  cardBrand       String?
  expiryMonth     Int
  expiryYear      Int
  status          PaymentMethodStatus   @default(ACTIVE)
  consentGivenAt  DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime
  amountAllocated Decimal?              @db.Decimal(10, 2)
  workflowStatus  PaymentWorkflowStatus @default(PENDING)
  contactId       String?
  PaymentCharge   PaymentCharge[]
  Booking         Booking?              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  Contact         Contact?              @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([contactId])
}

model Quote {
  id                                   String               @id
  quoteNumber                          String               @unique
  secureToken                          String               @unique
  leadId                               String
  contactId                            String
  agentId                              String?
  status                               QuoteStatus          @default(DRAFT)
  source                               QuoteSource          @default(MANUAL)
  currency                             String               @default("USD")
  adults                               Int                  @default(1)
  children                             Int                  @default(0)
  infants                              Int                  @default(0)
  adultPrice                           Decimal              @default(0) @db.Decimal(10, 2)
  childPrice                           Decimal              @default(0) @db.Decimal(10, 2)
  infantPrice                          Decimal              @default(0) @db.Decimal(10, 2)
  taxes                                Decimal              @default(0) @db.Decimal(10, 2)
  serviceFee                           Decimal              @default(0) @db.Decimal(10, 2)
  gratuity                             Decimal              @default(0) @db.Decimal(10, 2)
  total                                Decimal              @default(0) @db.Decimal(10, 2)
  termsAndConditions                   String?
  createdAt                            DateTime             @default(now())
  updatedAt                            DateTime
  sentAt                               DateTime?
  readAt                               DateTime?
  viewedAt                             DateTime?
  signedAt                             DateTime?
  bookedAt                             DateTime?
  canceledAt                           DateTime?
  internalNotes                        String?
  netTicketCost                        Decimal?             @db.Decimal(10, 2)
  lastActivityAt                       DateTime             @default(now())
  chargedAt                            DateTime?
  exchangeRate                         Decimal?             @db.Decimal(12, 6)
  pricingSnapshot                      Json?
  sentByAgentId                        String?
  Activity                             Activity[]
  Booking                              Booking?
  EmailLog                             EmailLog[]
  Itinerary                            Itinerary?
  Notification                         Notification[]
  Account                              Account?             @relation(fields: [agentId], references: [id])
  Contact                              Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Lead                                 Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Account_Quote_sentByAgentIdToAccount Account?             @relation("Quote_sentByAgentIdToAccount", fields: [sentByAgentId], references: [id])
  QuoteStatusHistory                   QuoteStatusHistory[]

  @@index([agentId])
  @@index([contactId])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([leadId])
  @@index([status])
  @@index([sentByAgentId])
}

model QuoteStatusHistory {
  id          String       @id
  quoteId     String
  fromStatus  QuoteStatus?
  toStatus    QuoteStatus
  changedById String?
  note        String?
  changedAt   DateTime     @default(now())
  Account     Account?     @relation(fields: [changedById], references: [id])
  Quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Sequence {
  id                 String               @id
  name               String
  description        String?
  isActive           Boolean              @default(true)
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  Account            Account?             @relation(fields: [createdById], references: [id])
  SequenceEnrollment SequenceEnrollment[]
  SequenceStep       SequenceStep[]
}

model SequenceEnrollment {
  id              String            @id
  sequenceId      String
  leadId          String
  status          EnrollmentStatus  @default(ACTIVE)
  currentStepIdx  Int               @default(0)
  enrolledAt      DateTime          @default(now())
  nextSendAt      DateTime?
  completedAt     DateTime?
  enrolledById    String?
  Account         Account?          @relation(fields: [enrolledById], references: [id])
  Lead            Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Sequence        Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  SequenceStepLog SequenceStepLog[]

  @@index([leadId])
  @@index([nextSendAt])
  @@index([sequenceId])
  @@index([status])
}

model SequenceStep {
  id              String            @id
  sequenceId      String
  order           Int
  subject         String
  body            String
  delayMinutes    Int               @default(0)
  createdAt       DateTime          @default(now())
  Sequence        Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  SequenceStepLog SequenceStepLog[]

  @@index([sequenceId])
}

model SequenceStepLog {
  id                 String             @id
  enrollmentId       String
  stepId             String
  status             StepLogStatus
  sentAt             DateTime?
  error              String?
  createdAt          DateTime           @default(now())
  SequenceEnrollment SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  SequenceStep       SequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

model Signature {
  id         String   @id
  bookingId  String   @unique
  signedName String
  signedAt   DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  Booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Task {
  id                                  String         @id
  contactId                           String?
  leadId                              String?
  assigneeId                          String?
  title                               String
  dueAt                               DateTime?
  status                              TaskStatus     @default(PENDING)
  completedAt                         DateTime?
  createdAt                           DateTime       @default(now())
  dueNotifiedAt                       DateTime?
  notes                               String?
  updatedAt                           DateTime
  completedById                       String?
  priority                            Priority       @default(MEDIUM)
  Notification                        Notification[]
  Account_Task_assigneeIdToAccount    Account?       @relation("Task_assigneeIdToAccount", fields: [assigneeId], references: [id])
  Account_Task_completedByIdToAccount Account?       @relation("Task_completedByIdToAccount", fields: [completedById], references: [id])
  Contact                             Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Lead                                Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([assigneeId])
  @@index([contactId])
  @@index([dueAt])
  @@index([leadId])
  @@index([status])
}

model ContactInquiry {
  id               String         @id @default(cuid())
  companyId        String
  firstName        String
  lastName         String
  email            String
  phone            String?
  subject          InquirySubject
  message          String
  status           InquiryStatus  @default(NEW)
  assignedAdminId  String?
  readAt           DateTime?
  matchedContactId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  Account          Account?       @relation(fields: [assignedAdminId], references: [id])
  Company          Company        @relation(fields: [companyId], references: [id])
  Contact          Contact?       @relation(fields: [matchedContactId], references: [id])
  InquiryNote      InquiryNote[]

  @@index([companyId])
  @@index([matchedContactId])
  @@index([status])
}

model InquiryNote {
  id             String         @id
  inquiryId      String
  authorId       String?
  body           String
  createdAt      DateTime       @default(now())
  Account        Account?       @relation(fields: [authorId], references: [id])
  ContactInquiry ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

model MarketingCampaign {
  id                    String                  @id
  companyId             String
  name                  String
  subject               String
  htmlContent           String
  status                CampaignStatus          @default(DRAFT)
  createdById           String?
  sentAt                DateTime?
  recipientCount        Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  Company               Company                 @relation(fields: [companyId], references: [id])
  Account               Account?                @relation(fields: [createdById], references: [id])
  MarketingCampaignSend MarketingCampaignSend[]

  @@index([companyId])
}

model MarketingCampaignSend {
  id                String              @id
  campaignId        String
  subscriberId      String
  status            MarketingSendStatus @default(PENDING)
  sentAt            DateTime?
  errorMessage      String?
  createdAt         DateTime            @default(now())
  MarketingCampaign MarketingCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  Subscriber        Subscriber          @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([subscriberId])
}

model Subscriber {
  id                    String                  @id @default(cuid())
  companyId             String
  email                 String
  status                SubscriberStatus        @default(SUBSCRIBED)
  source                String?
  subscribedAt          DateTime                @default(now())
  unsubscribedAt        DateTime?
  unsubscribeToken      String                  @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  MarketingCampaignSend MarketingCampaignSend[]
  Company               Company                 @relation(fields: [companyId], references: [id])

  @@unique([companyId, email])
  @@index([companyId])
  @@index([status])
}

