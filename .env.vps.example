# Environment for the self-hosted (OVHcloud VPS + Docker Compose + Cloudflare Tunnel) deployment. Placeholders only —
# copy to `.env` NEXT TO compose.yaml on the server, then `chmod 600 .env`. Never commit the real file. Guide: docs/DEPLOYMENT_VPS.md

# --- Database (REQUIRED) -------------------------------------------------------------------------------------------------------
# The CRM's PostgreSQL, reached by its compose service name `db` on the CRM's network. Use the website's own
# least-privilege runtime role (docs/DEPLOYMENT_VPS.md, "Database permissions") — NOT the PostgreSQL superuser and NOT the CRM's
# application role. Special characters in the password must be URL-encoded. Do not put ssl* parameters in the URL (they are removed).
DATABASE_URL=postgresql://<runtime_role>:<url_encoded_password>@db:5432/<database_name>

# --- Database TLS: choose EXACTLY ONE (deploy/preflight.sh refuses to continue if none is set) -------------------------------------
# A) PREFERRED - verified TLS: the PostgreSQL server must offer TLS with a certificate whose name matches the host in DATABASE_URL.
#    Paste the CA certificate (PEM; newlines may be written as literal \n).
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n<...>\n-----END CERTIFICATE-----
#    or, for a publicly trusted CA:
# DATABASE_SSL_VERIFY=system
# B) EXCEPTION - plaintext, for an owner-approved private Docker-network connection to the `db` container ONLY (the server in the
#    container must not publish a port; src/lib/db-tls.ts refuses it for any other host). Record the approval in the runbook before using it.
# DATABASE_SSL_MODE=disable

# --- Notification email (REQUIRED) -----------------------------------------------------------------------------------------------
GMAIL_SENDER_EMAIL=<the-single-gmail-address@example.com>
GMAIL_APP_PASSWORD=<google-app-password>

# --- Docker / networking (optional overrides; defaults shown) --------------------------------------------------------------------
# The CRM project's existing network (it carries the CRM app, `db` and `cloudflared`). It must already exist; compose never creates it.
# Read the real name with `docker network ls` — do not guess.
# CRM_NETWORK_NAME=compass-tools_internal
# Image tag, for rollback: APP_VERSION=<git short sha>
# APP_VERSION=

# Set by compose.yaml and deliberately NOT configurable here: TRUSTED_PROXY=cloudflare, DATABASE_AUTO_INIT=false.
