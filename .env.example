# Copy this file to .env (or set these directly in the host's environment) and fill in the real values.
# Never commit a real secret — this file documents variable NAMES and placeholders only.
# See docs/ENVIRONMENT.md for where each value comes from. The site's own content (destinations, airlines, airports, the flight-request
# form's airport autocomplete) lives in src/data/ and needs none of this; only SUBMITTING a form does.

# --- Compass Tools CRM (server-to-server) --------------------------------------------------------------------------------------
# The website has NO database and no database credential. Every form is sent to the Compass Tools CRM over HTTP
# (docs/CRM_API_INTEGRATION.md). All of these are server-side only: never a NEXT_PUBLIC_* variable, never in client code, never logged.

# Origin of the CRM, no path. On the self-hosted VPS: the CRM's private website-API network answers as http://compass-crm:3000.
CRM_API_URL=http://compass-crm:3000

# Bearer key for POST /api/v1/website/flight-inquiries — the same value as the CRM's WEBSITE_API_KEY (at least 32 characters, e.g. the
# output of `openssl rand -hex 32` generated on the CRM side). Required for flight requests.
CRM_API_KEY=<same-value-as-the-CRMs-WEBSITE_API_KEY>

# The CRM Company id (the CRM's WEBSITE_API_COMPANY_ID). Required for the contact form and the newsletter sign-up, which use the CRM's
# public endpoints and name the company in the request body.
CRM_COMPANY_ID=<crm-company-id>

# Optional. When set (at least 32 characters, identical to the CRM's LEAD_INGEST_SECRET) the visitor's IP address and approximate location
# are sent with a flight request inside a signed context so the CRM can record them. Unset = leads are created without them.
LEAD_INGEST_SECRET=

# --- Internal Flight Request email notification -----------------------------------------------------------------------------------
# Separate from, and never affecting, the customer's own successful submission response: a best-effort email to the Business Flights
# Travel team after the CRM has accepted a flight request. See src/lib/email/flight-request-notification.ts and docs/ENVIRONMENT.md.
# Unset = the feature is simply inactive; no error, nothing sent.
# Only two variables — the same Gmail address is both the sender AND the recipient.

# The Gmail account that authenticates, sends, AND receives the "New Flight Request" notification. Must be a real Gmail/Google Workspace
# address with 2-Step Verification enabled so it can generate an App Password (below).
GMAIL_SENDER_EMAIL=

# A Google-generated App Password for GMAIL_SENDER_EMAIL — NOT that account's normal login password. Create one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification already on). Server-side only: never commit the real value,
# never put it in a NEXT_PUBLIC_* variable, never log it.
GMAIL_APP_PASSWORD=

# --- Client IP and approximate location (flight requests) --------------------------------------------------------------------------
# Which proxy in front of the app is trusted to set the visitor's address: none | vercel | cloudflare | nginx | generic. The self-hosted
# deployment sets TRUSTED_PROXY=cloudflare itself (compose.yaml). Anywhere that is not a trusted proxy (local `next dev`) no forwarded
# header is believed and no IP is captured. No IP-intelligence provider, API key or credential is involved (src/lib/client-ip.ts).
TRUSTED_PROXY=
