# Copy this file to .env (or set this directly in your hosting provider's
# environment variable settings for production) and fill in the real value.
# Never commit a real secret — this file documents the variable NAME only.
# See docs/ENVIRONMENT.md for where the value comes from.

# --- Database / CRM integration ---------------------------------------------
# The shared "Compass Tools" CRM's PostgreSQL connection string. Flight
# requests, contact messages, and newsletter signups are written directly
# into this database's Lead/ContactInquiry/Subscriber tables. Destinations,
# airlines, airline logos, and airports do NOT come from this database — see
# src/data/ — so the site's core content, including the flight-request
# form's airport autocomplete, works even before this is set. Only
# submitting a form actually requires it.
DATABASE_URL=

# Optional, and unset by default. Read by the runtime schema guard
# (src/lib/schema-guard.ts) and by the Vercel build step
# (scripts/vercel-build.mjs); see docs/ENVIRONMENT.md.
# The above DATABASE_URL is normally expected to already point at the real,
# already-migrated Compass Tools database, in which case this variable does
# nothing and does not need to be set. Set it to exactly "true" ONLY when
# DATABASE_URL intentionally points at a brand-new, genuinely empty
# PostgreSQL database for this deployment (a new environment, a
# disaster-recovery instance, etc.) — doing so lets scripts/vercel-build.mjs
# create the required Compass Tools-compatible schema and the single
# Business Flights Travel Company record there automatically. This exists
# specifically so a wrong/stale DATABASE_URL can never silently initialize
# an orphan database in production — see that script's file header for the
# full incident this was added to prevent.
DATABASE_AUTO_INIT=

# --- Internal Flight Request email notification -----------------------------
# Separate from, and never affecting, the customer's own successful
# submission response: a best-effort email to the Business Flights Travel
# team after a flight request is validated and saved. See
# src/lib/email/flight-request-notification.ts and docs/ENVIRONMENT.md.
# Unset = the feature is simply inactive; no error, nothing sent.
# Only two variables — the same Gmail address is both the sender AND the
# recipient (it authenticates, sends, and receives this one notification;
# there is no separate notification-recipient variable).

# The Gmail account that authenticates, sends, AND receives the "New Flight
# Request" notification — it arrives back in this same inbox as a normal new
# email. Must be a real Gmail/Google Workspace address with 2-Step
# Verification enabled so it can generate an App Password (below).
GMAIL_SENDER_EMAIL=

# A Google-generated App Password for GMAIL_SENDER_EMAIL — NOT that
# account's normal login password. Create one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# already on). Server-side only: never commit the real value, never put it
# in a NEXT_PUBLIC_* variable, never log it.
GMAIL_APP_PASSWORD=

# --- Client IP and approximate location (flight requests) --------------------
# Optional, and normally left unset. On Vercel the platform sets VERCEL=1 itself
# and the server then reads the visitor's full IP address and an approximate,
# IP-derived location from the headers Vercel's own edge sets (see
# src/lib/client-ip.ts and docs/ENVIRONMENT.md). No IP-intelligence provider,
# API key or credential is involved.
# Set it only to override that detection: none | vercel | cloudflare | nginx |
# generic. "none" turns IP capture off. Anywhere that is not a trusted proxy
# (local `next dev`) no forwarded header is believed and no IP is stored.
TRUSTED_PROXY=
